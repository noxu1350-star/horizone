<section class="pd pd-cats" aria-labelledby="PdCatsHeading-{{ section.id }}">
  <div class="pd__inner pd-cats__inner">
    <div class="pd-cats__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pd-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="PdCatsHeading-{{ section.id }}" class="pd-display pd-cats__title">{{ section.settings.heading }}</h2>
      <span class="pd-rule" aria-hidden="true"></span>
      {%- if section.settings.text != blank -%}
        <div class="pd-cats__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="pd-btn pd-btn--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>

    <ul class="pd-cats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign title = block.settings.title | default: col.title
          assign url = block.settings.link | default: col.url | default: routes.all_products_collection_url
          assign img = block.settings.image | default: col.featured_image
        -%}
        <li class="pd-cat{% if img == blank and block.settings.placeholder == 'design' %} pd-cat--emblem{% endif %}" {{ block.shopify_attributes }}>
          <a class="pd-cat__link" href="{{ url }}">
            <span class="pd-cat__copy">
              <span class="pd-cat__title">{{ title | default: 'Category' }}</span>
              {%- if block.settings.text != blank -%}
                <span class="pd-cat__text">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
            <span class="pd-cat__media">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 600
                  | image_tag:
                    class: 'pd-cat__img',
                    loading: 'lazy',
                    widths: '240, 360, 480, 600',
                    sizes: '(min-width: 990px) 18vw, 45vw',
                    alt: ''
                }}
              {%- else -%}
                {%- render 'pd-placeholder',
                  type: block.settings.placeholder,
                  color: block.settings.placeholder_color,
                  uid: block.id,
                  label: title,
                  class: 'pd-cat__img'
                -%}
              {%- endif -%}
            </span>
            <span class="pd-cat__arrow" aria-hidden="true">{% render 'pd-icon', icon: 'chevron' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .pd-cats {
    border-bottom: 1px solid var(--pd-line);
  }

  .pd-cats__inner {
    display: grid;
    gap: 24px;
    padding-block: clamp(32px, 5vw, 48px);
  }

  .pd-cats__title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-top: 4px;
  }

  .pd-cats__text {
    color: var(--pd-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 240px;
    margin-bottom: 20px;
  }

  .pd-cats__text p {
    margin: 0;
  }

  .pd-cats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .pd-cat__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 200px;
    padding: 16px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background:
      radial-gradient(ellipse 80% 70% at 70% 65%, rgb(90 140 220 / 0.14), transparent 70%),
      var(--pd-navy-2);
    border: 1px solid var(--pd-line);
    border-radius: 4px;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .pd-cat__link:hover {
    border-color: rgb(from var(--pd-gold) r g b / 0.7);
    transform: translateY(-2px);
  }

  .pd-cat__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
    max-width: 60%;
  }

  .pd-cat__title {
    font-family: var(--pd-font-display);
    font-weight: var(--pd-font-weight);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.05rem;
  }

  .pd-cat__text {
    color: var(--pd-muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .pd-cat__media {
    position: absolute;
    right: -4%;
    bottom: 0;
    width: 68%;
    height: 82%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .pd-cat__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
    transition: transform 0.35s ease;
    filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.45));
  }

  .pd-cat__media::before {
    content: '';
    position: absolute;
    right: 8%;
    bottom: 4%;
    width: 70%;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(120 170 255 / 0.25), transparent 70%);
  }

  /* Emblem tiles sit below the text instead of behind it */
  .pd-cat--emblem .pd-cat__copy {
    max-width: 100%;
  }

  .pd-cat--emblem .pd-cat__link {
    min-height: 260px;
  }

  .pd-cat--emblem .pd-cat__media {
    right: 10px;
    bottom: 10px;
    width: 62%;
    max-width: 150px;
    height: auto;
    aspect-ratio: 1;
  }

  .pd-cat--emblem .pd-cat__media::before {
    display: none;
  }

  .pd-cat__link:hover .pd-cat__img {
    transform: scale(1.05);
  }

  .pd-cat__arrow {
    position: relative;
    z-index: 1;
    margin-top: auto;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--pd-text);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .pd-cat__arrow svg {
    width: 16px;
    height: 16px;
  }

  .pd-cat__link:hover .pd-cat__arrow {
    color: var(--pd-gold);
    transform: translateX(4px);
  }

  @media (min-width: 750px) {
    .pd-cat__link {
      min-height: 230px;
    }
  }

  @media (min-width: 990px) {
    .pd-cats__inner {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 32px;
      align-items: stretch;
    }

    .pd-cats__grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .pd-cat__copy {
      max-width: 48%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PD · Shop by category",
  "tag": "div",
  "class": "pd-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Category"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Gear for every mission and every day.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection name."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent product cut-out (PNG/WebP) looks best. Defaults to the collection image."
        },
        {
          "type": "select",
          "id": "placeholder",
          "label": "Placeholder (when no image)",
          "options": [
            { "value": "tshirt", "label": "T-shirt" },
            { "value": "hoodie", "label": "Hoodie" },
            { "value": "hat", "label": "Hat" },
            { "value": "pants", "label": "Joggers" },
            { "value": "design", "label": "Emblem with title (good for branches)" }
          ],
          "default": "tshirt"
        },
        {
          "type": "color",
          "id": "placeholder_color",
          "label": "Placeholder garment color",
          "default": "#1b2a47"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Overrides the collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PD · Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "T-shirts", "text": "Built for comfort. Made to make a statement.", "placeholder": "tshirt", "placeholder_color": "#1b2a47" } },
        { "type": "category", "settings": { "title": "Hoodies", "text": "Premium warmth. Purpose-driven designs.", "placeholder": "hoodie", "placeholder_color": "#151a22" } },
        { "type": "category", "settings": { "title": "Hats", "text": "Top off your look. Rep the mission everywhere.", "placeholder": "hat", "placeholder_color": "#151a22" } },
        { "type": "category", "settings": { "title": "Bottoms", "text": "Comfort meets durability for everyday wear.", "placeholder": "pants", "placeholder_color": "#151a22" } }
      ]
    }
  ]
}
{% endschema %}
