{%- assign flag = section.settings.flag_image -%}

<section class="pd pd-mission" aria-labelledby="PdMissionHeading-{{ section.id }}">
  <div class="pd-mission__flag" aria-hidden="true">
    {%- if flag != blank -%}
      {{
        flag
        | image_url: width: 1400
        | image_tag: class: 'pd-mission__flag-img', loading: 'lazy', widths: '600, 1000, 1400', sizes: '50vw', alt: ''
      }}
    {%- else -%}
      <span class="pd-mission__flag-css">{% render 'pd-placeholder', type: 'flag', uid: section.id %}</span>
    {%- endif -%}
  </div>

  <div class="pd__inner pd-mission__inner">
    <div class="pd-mission__main">
      <div class="pd-mission__seal" aria-hidden="true">
        {%- if section.settings.seal_image != blank -%}
          {{ section.settings.seal_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
        {%- else -%}
          <span class="pd-mission__seal-ring">{% render 'pd-icon', icon: 'star' %}</span>
        {%- endif -%}
      </div>

      <div class="pd-mission__copy">
        <h2 id="PdMissionHeading-{{ section.id }}" class="pd-display pd-mission__title">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="pd-mission__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="pd-btn pd-btn--outline pd-mission__btn" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label -}}
            {% render 'pd-icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="pd-mission__pillars" role="list">
        {%- for block in section.blocks -%}
          <li class="pd-pillar" {{ block.shopify_attributes }}>
            <span class="pd-pillar__icon" aria-hidden="true">{% render 'pd-icon', icon: block.settings.icon %}</span>
            <span class="pd-pillar__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="pd-pillar__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pd-mission {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(90deg, transparent 0%, var(--pd-navy) 48%),
      var(--pd-navy);
  }

  .pd-mission__flag {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(52%, 760px);
    z-index: -1;
    -webkit-mask-image: linear-gradient(90deg, #000 30%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 30%, transparent 100%);
    opacity: 0.55;
  }

  .pd-mission__flag-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CSS-only waving flag fallback */
  .pd-mission__flag-css {
    position: absolute;
    inset: 0;
    filter: saturate(0.8) brightness(0.6);
    transform: skewY(-5deg) scale(1.2);
    transform-origin: left top;
  }

  .pd-mission__flag-css svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pd-mission__inner {
    display: grid;
    gap: 32px;
    padding-block: clamp(40px, 6vw, 64px);
  }

  .pd-mission__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .pd-mission__seal {
    width: 80px;
  }

  .pd-mission__seal img {
    width: 100%;
    height: auto;
    display: block;
  }

  .pd-mission__seal-ring {
    width: 80px;
    height: 80px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--pd-text);
    background: radial-gradient(circle, var(--pd-navy-2) 58%, transparent 59%);
    border: 3px double var(--pd-gold);
    box-shadow: 0 0 0 4px var(--pd-navy), 0 0 0 5px rgb(from var(--pd-gold) r g b / 0.5);
  }

  .pd-mission__seal-ring svg {
    width: 34px;
    height: 34px;
    fill: currentColor;
  }

  .pd-mission__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.05;
  }

  .pd-mission__title em,
  .pd-mission__title strong {
    font-style: normal;
    color: var(--pd-gold);
  }

  .pd-mission__text {
    color: var(--pd-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 520px;
    margin-top: 14px;
  }

  .pd-mission__text p {
    margin: 0 0 0.6em;
  }

  .pd-mission__btn {
    margin-top: 12px;
  }

  .pd-mission__pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    align-items: start;
    gap: 24px 16px;
  }

  .pd-pillar__icon svg {
    display: block;
  }

  .pd-pillar {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 6px;
  }

  .pd-pillar__icon {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1.5px solid rgb(from var(--pd-text) r g b / 0.7);
    color: var(--pd-text);
    margin-bottom: 6px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pd-pillar:hover .pd-pillar__icon {
    border-color: var(--pd-gold);
    color: var(--pd-gold);
  }

  .pd-pillar__icon svg {
    width: 30px;
    height: 30px;
  }

  .pd-pillar__title {
    font-family: var(--pd-font-display);
    font-weight: var(--pd-font-weight);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 1rem;
  }

  .pd-pillar__text {
    color: var(--pd-muted);
    font-size: 0.82rem;
    line-height: 1.4;
    max-width: 170px;
  }

  @media (max-width: 749px) {
    .pd-mission__pillars {
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      gap: 20px 10px;
    }

    .pd-pillar__icon {
      width: 52px;
      height: 52px;
    }

    .pd-pillar__icon svg {
      width: 24px;
      height: 24px;
    }

    .pd-pillar__text {
      font-size: 0.75rem;
    }
  }

  @media (min-width: 990px) {
    .pd-mission__pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pd-mission__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
      gap: 48px;
      padding-left: max(clamp(16px, 4vw, 48px), 14%);
    }

    .pd-mission__seal,
    .pd-mission__seal-ring {
      width: 96px;
      height: 96px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PD · Mission band",
  "tag": "div",
  "class": "pd-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your gear. Your message."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading gold words",
      "default": "Our mission."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Phonetic Designs is a veteran-owned brand dedicated to honoring service, celebrating military families and raising awareness of the challenges veterans face, especially homelessness. Every purchase helps keep the mission visible and the memory of service never forgotten.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to hide.",
      "default": "Our mission"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "The button only shows once a link is set (e.g. your Our Mission page)."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "flag_image",
      "label": "Flag image",
      "info": "Optional. A built-in flag graphic is used when empty."
    },
    {
      "type": "image_picker",
      "id": "seal_image",
      "label": "Seal / badge image",
      "info": "Optional. e.g. a Veteran-Owned badge."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "megaphone", "label": "Megaphone" },
            { "value": "handshake", "label": "Handshake" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "flag", "label": "Flag" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Honor"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "We honor veterans and their families."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PD · Mission band",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "shield", "title": "Honor", "text": "We honor veterans and their families." } },
        { "type": "pillar", "settings": { "icon": "megaphone", "title": "Awareness", "text": "We raise awareness and start conversations." } },
        { "type": "pillar", "settings": { "icon": "handshake", "title": "Action", "text": "We take action to create real change." } }
      ]
    }
  ]
}
{% endschema %}
