{%- liquid
  assign bg = section.settings.background_image
  assign models = section.settings.models_image
-%}

<section
  class="pd pd-hero{% if bg != blank %} pd-hero--has-bg{% endif %}"
  style="--pd-hero-min: {{ section.settings.min_height }}vh; --pd-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  aria-labelledby="PdHeroHeading-{{ section.id }}"
>
  <div class="pd-hero__backdrop" aria-hidden="true">
    {%- if bg != blank -%}
      {{
        bg
        | image_url: width: 2400
        | image_tag:
          class: 'pd-hero__bg-img',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000, 2400',
          alt: ''
      }}
    {%- endif -%}
    <span class="pd-hero__flag"></span>
    <span class="pd-hero__glow"></span>
    <span class="pd-hero__grid"></span>
  </div>

  <div class="pd__inner pd-hero__inner">
    <div class="pd-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pd-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 id="PdHeroHeading-{{ section.id }}" class="pd-display pd-hero__title">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %}
          <em>{{ section.settings.heading_accent | escape }}</em>
        {%- endif %}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="pd-display pd-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="pd-hero__body">{{ section.settings.body }}</div>
      {%- endif -%}

      <div class="pd-hero__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a class="pd-btn pd-btn--primary" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_1_label }}
            {% render 'pd-icon', icon: 'chevron' %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="pd-btn pd-btn--ghost" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="pd-hero__visual">
      <span class="pd-hero__emblem" aria-hidden="true">{% render 'pd-icon', icon: 'emblem' %}</span>
      {%- if models != blank -%}
        {{
          models
          | image_url: width: 1600
          | image_tag:
            class: 'pd-hero__models',
            loading: 'eager',
            sizes: '(min-width: 990px) 55vw, 100vw',
            widths: '600, 900, 1200, 1600',
            alt: models.alt
        }}
      {%- else -%}
        <div class="pd-hero__stage">
          <span class="pd-hero__floor" aria-hidden="true"></span>
          <div class="pd-hero__garment pd-hero__garment--back">
            {% render 'pd-placeholder', type: 'hoodie', color: '#151a22', uid: section.id %}
          </div>
          <div class="pd-hero__garment pd-hero__garment--front">
            {% render 'pd-placeholder', type: 'tshirt', color: '#1b2a47', uid: section.id %}
          </div>
          <div class="pd-hero__garment pd-hero__garment--hat">
            {% render 'pd-placeholder', type: 'hat', color: '#151a22', uid: section.id %}
          </div>
        </div>
        {%- if request.design_mode -%}
          <span class="pd-hero__hint">Upload a models image in this section's settings</span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pd-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: min(var(--pd-hero-min, 78vh), 860px);
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--pd-line);
  }

  .pd-hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .pd-hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd-hero--has-bg .pd-hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--pd-navy) 0%, rgb(from var(--pd-navy) r g b / var(--pd-hero-overlay)) 55%, rgb(from var(--pd-navy) r g b / 0.2) 100%);
  }

  /* Faded flag stripes + star field on the left, like the mockup */
  .pd-hero__flag {
    position: absolute;
    inset: 0 45% 0 0;
    opacity: 0.16;
    background:
      radial-gradient(circle, #fff 0 1.5px, transparent 2px) 0 0 / 34px 30px,
      repeating-linear-gradient(180deg, #b8263a 0 26px, transparent 26px 52px);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0%, transparent 100%);
  }

  .pd-hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 60% at 72% 40%, rgb(70 130 220 / 0.28), transparent 70%),
      radial-gradient(ellipse 60% 50% at 20% 110%, rgb(from var(--pd-gold) r g b / 0.08), transparent 70%);
  }

  /* Mission-control light panels */
  .pd-hero__grid {
    position: absolute;
    inset: 0 0 0 50%;
    background:
      linear-gradient(90deg, transparent 0 18%, rgb(140 190 255 / 0.16) 18% 18.6%, transparent 18.6% 82%, rgb(140 190 255 / 0.16) 82% 82.6%, transparent 82.6%),
      linear-gradient(180deg, transparent 0 12%, rgb(140 190 255 / 0.1) 12% 12.5%, transparent 12.5%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 75%);
  }

  .pd-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    padding-block: clamp(48px, 8vw, 96px) 0;
  }

  .pd-hero__content {
    max-width: 620px;
    position: relative;
    z-index: 1;
  }

  .pd-hero__title {
    font-size: clamp(3rem, 9vw, 6.4rem);
    margin-top: 14px;
  }

  .pd-hero__title em,
  .pd-hero__title strong {
    font-style: normal;
    color: var(--pd-gold);
  }

  .pd-hero__sub {
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.1;
    margin-top: 18px;
  }

  .pd-hero__body {
    color: var(--pd-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 460px;
    margin-top: 14px;
  }

  .pd-hero__body p {
    margin: 0;
  }

  .pd-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .pd-hero__visual {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 280px;
    align-self: stretch;
  }

  .pd-hero__emblem {
    position: absolute;
    top: 6%;
    left: 50%;
    width: min(46%, 260px);
    transform: translateX(-50%);
    color: #cfe0ff;
    opacity: 0.55;
    filter: drop-shadow(0 0 18px rgb(120 170 255 / 0.55)) drop-shadow(0 0 48px rgb(120 170 255 / 0.3));
  }

  .pd-hero__emblem svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .pd-hero__models {
    position: relative;
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    max-height: 640px;
    object-fit: contain;
    object-position: bottom center;
  }

  .pd-hero__emblem {
    animation: pd-hero-pulse 4.5s ease-in-out infinite;
  }

  @keyframes pd-hero-pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.7; }
  }

  /* Placeholder "models" scene, shown until an image is uploaded */
  .pd-hero__stage {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 16 / 12;
    margin-top: 40px;
  }

  .pd-hero__floor {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 0;
    height: 18%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(120 170 255 / 0.35), rgb(120 170 255 / 0.08) 45%, transparent 70%);
    border-top: 1px solid rgb(140 190 255 / 0.25);
  }

  .pd-hero__garment {
    position: absolute;
    bottom: 5%;
    filter: drop-shadow(0 24px 30px rgb(0 0 0 / 0.6));
    animation: pd-hero-float 6s ease-in-out infinite;
  }

  .pd-hero__garment .pd-ph {
    display: block;
    width: 100%;
    height: auto;
  }

  .pd-hero__garment--back {
    right: 2%;
    width: 52%;
    animation-delay: -3s;
  }

  .pd-hero__garment--front {
    left: 4%;
    width: 54%;
    z-index: 1;
  }

  .pd-hero__garment--hat {
    left: 44%;
    bottom: 1%;
    width: 22%;
    z-index: 2;
    animation-delay: -1.5s;
  }

  @keyframes pd-hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .pd-hero__hint {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 6px 12px;
    font-size: 0.75rem;
    white-space: nowrap;
    color: var(--pd-navy);
    background: var(--pd-gold);
    border-radius: 99px;
    z-index: 3;
  }

  @media (min-width: 990px) {
    .pd-hero__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      padding-block: 0;
    }

    .pd-hero__content {
      padding-block: 80px;
    }

    .pd-hero__visual {
      min-height: 100%;
      padding-top: 40px;
    }
  }

  @media (max-width: 749px) {
    .pd-hero__actions .pd-btn {
      flex: 1 1 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PD · Mission hero",
  "tag": "div",
  "class": "pd-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Veteran-owned & operated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Wear the"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Headline gold words",
      "default": "Mission."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting headline",
      "default": "No veteran should be forgotten."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Create apparel that honors service, celebrates military families and keeps the mission visible.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Create your gear"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Shop all designs"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "models_image",
      "label": "Models / apparel image",
      "info": "Transparent PNG or WebP of models wearing your gear works best (about 1400 × 1200px). Shown on the right."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Darkened automatically so text stays readable."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "PD · Mission hero"
    }
  ]
}
{% endschema %}
