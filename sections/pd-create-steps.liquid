<section class="pd pd-steps" aria-labelledby="PdStepsHeading-{{ section.id }}">
  <div class="pd__inner pd-steps__inner">
    <div class="pd-steps__intro">
      <h2 id="PdStepsHeading-{{ section.id }}" class="pd-display pd-steps__title">{{ section.settings.heading }}</h2>
      <span class="pd-rule" aria-hidden="true"></span>
      {%- if section.settings.text != blank -%}
        <div class="pd-steps__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="pd-btn pd-btn--outline pd-steps__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>

    <ol class="pd-steps__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign step_link = block.settings.link -%}
        <li class="pd-step" {{ block.shopify_attributes }}>
          {%- if step_link != blank -%}<a class="pd-step__link" href="{{ step_link }}">{%- endif -%}
          <span class="pd-step__num" aria-hidden="true">{{ forloop.index }}</span>
          <span class="pd-step__copy">
            <span class="pd-step__title">
              <span class="visually-hidden">Step {{ forloop.index }}: </span>{{ block.settings.title }}
            </span>
            {%- if block.settings.text != blank -%}
              <span class="pd-step__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 320
              | image_tag: class: 'pd-step__img', loading: 'lazy', widths: '160, 240, 320', sizes: '120px', alt: block.settings.image.alt
            }}
          {%- else -%}
            <span class="pd-step__ph" aria-hidden="true">
              {%- render 'pd-placeholder', type: block.settings.placeholder, color: '#1b2a47', uid: block.id -%}
            </span>
          {%- endif -%}
          {%- if step_link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .pd-steps {
    border-bottom: 1px solid var(--pd-line);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.02), transparent),
      var(--pd-navy);
  }

  .pd-steps__inner {
    display: grid;
    gap: 24px;
    padding-block: clamp(32px, 5vw, 48px);
  }

  .pd-steps__title {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
  }

  .pd-steps__text {
    color: var(--pd-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 320px;
  }

  .pd-steps__text p {
    margin: 0;
  }

  .pd-steps__btn {
    margin-top: 18px;
  }

  .pd-steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    counter-reset: pd-step;
  }

  .pd-step {
    position: relative;
    background: var(--pd-navy-2);
    border: 1px solid var(--pd-line);
    border-radius: 4px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pd-step:hover {
    border-color: rgb(from var(--pd-gold) r g b / 0.6);
  }

  .pd-step,
  .pd-step__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    color: inherit;
    text-decoration: none;
  }

  .pd-step:has(.pd-step__link) {
    padding: 0;
  }

  .pd-step__link {
    width: 100%;
  }

  .pd-step__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1.5px solid rgb(from var(--pd-text) r g b / 0.7);
    font-family: var(--pd-font-display);
    font-weight: var(--pd-font-weight);
    font-size: 1.3rem;
  }

  .pd-step__copy {
    display: grid;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .pd-step__title {
    font-family: var(--pd-font-display);
    font-weight: var(--pd-font-weight);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
  }

  .pd-step__text {
    color: var(--pd-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .pd-step__img {
    flex: none;
    width: 84px;
    height: 72px;
    object-fit: contain;
  }

  .pd-step__ph {
    flex: none;
    width: 84px;
    height: 76px;
    display: grid;
    place-items: center;
    filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.5));
    transition: transform 0.25s ease;
  }

  .pd-step__ph svg {
    width: 100%;
    height: 100%;
  }

  .pd-step:hover .pd-step__ph,
  .pd-step:hover .pd-step__img {
    transform: scale(1.06) rotate(-2deg);
  }

  .pd-step__img {
    transition: transform 0.25s ease;
  }

  @media (min-width: 990px) {
    .pd-steps__inner {
      grid-template-columns: 260px minmax(0, 1fr);
      align-items: center;
      gap: 32px;
    }

    .pd-steps__list {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 0;
    }

    /* Chevron-shaped cards that point into each other */
    .pd-step {
      --pd-notch: 22px;
      border: 0;
      border-radius: 0;
      min-height: 112px;
      clip-path: polygon(0 0, calc(100% - var(--pd-notch)) 0, 100% 50%, calc(100% - var(--pd-notch)) 100%, 0 100%, var(--pd-notch) 50%);
      background:
        linear-gradient(var(--pd-navy-2), var(--pd-navy-2)) padding-box;
      margin-left: -10px;
      filter: drop-shadow(0 0 0 transparent);
    }

    .pd-step:first-child {
      margin-left: 0;
      clip-path: polygon(0 0, calc(100% - var(--pd-notch)) 0, 100% 50%, calc(100% - var(--pd-notch)) 100%, 0 100%);
    }

    .pd-step::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(90deg, rgb(from var(--pd-text) r g b / 0.08), transparent 40%);
    }

    .pd-step:hover {
      background: color-mix(in srgb, var(--pd-navy-2) 85%, var(--pd-gold));
    }

    .pd-step,
    .pd-step__link {
      padding: 16px 30px 16px 34px;
    }

    .pd-step:first-child:not(:has(.pd-step__link)),
    .pd-step:first-child .pd-step__link {
      padding-left: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PD · Create your gear",
  "tag": "div",
  "class": "pd-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create your gear"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Design apparel that delivers your message with purpose.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to hide.",
      "default": "Start creating"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose product"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Select your favorite gear."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Small product or design image (transparent PNG/WebP). A placeholder is shown if empty."
        },
        {
          "type": "select",
          "id": "placeholder",
          "label": "Placeholder (when no image)",
          "options": [
            { "value": "tshirt", "label": "T-shirt" },
            { "value": "design", "label": "Design" },
            { "value": "hoodie", "label": "Hoodie" },
            { "value": "hat", "label": "Hat" },
            { "value": "pants", "label": "Joggers" }
          ],
          "default": "tshirt"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PD · Create your gear",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose product", "text": "Select your favorite gear.", "placeholder": "tshirt" } },
        { "type": "step", "settings": { "title": "Customize design", "text": "Add your message, colors and details.", "placeholder": "design" } },
        { "type": "step", "settings": { "title": "Preview & order", "text": "Review your gear and place your order.", "placeholder": "hoodie" } }
      ]
    }
  ]
}
{% endschema %}
